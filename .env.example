# Copy to .env and fill in. Never commit .env (it is git-ignored).

# ─── Database ────────────────────────────────────────────────────────────────
# Connection the APP uses at runtime.
#   Local (npx prisma dev -d -n stocksense):
#     postgres://postgres:postgres@localhost:51218/template1?sslmode=disable
#   Neon: the POOLED connection string (host contains "-pooler")
#   Supabase: the "Transaction pooler" connection string (port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Connection the Prisma CLI uses for migrations. Must be DIRECT (unpooled) on
# Neon/Supabase. Leave unset locally; DATABASE_URL is used instead.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require"

# Local `prisma dev` only: its dedicated shadow database (used by `prisma migrate dev`).
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Optional cap on the app's connection pool. Use 1 with local `prisma dev`
# (PGlite is single-session; parallel connections + transactions can crash it).
# Leave unset for hosted Postgres.
# DATABASE_POOL_MAX=1

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing session JWTs (32+ random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# ─── Tests (npm test) ────────────────────────────────────────────────────────
# Tests create and drop their OWN schema (default "stocksense_test") in this
# database; they never touch "public". Defaults to DATABASE_URL.
# With local `prisma dev`, give tests a SEPARATE instance: PGlite shares one
# session per server, so settings from the test run would leak into the app.
#   npx prisma dev -d -n stocksense-test
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable"
# TEST_DATABASE_SCHEMA="stocksense_test"
